# ==============================================================================
# O.M.E.G.A — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your keys.
# Do NOT commit your real .env file.

# Gemini API Keys (comma-separated for key rotation and bounded retries)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# Default Gemini Model
GEMINI_MODEL=gemini-2.5-flash

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Storage Paths (relative to backend or absolute)
DATA_DIR=./data
DATABASE_PATH=./data/omega.db

# Security & Workspace Boundaries
ALLOWED_WORKSPACES=.
REQUIRE_DESTRUCTIVE_CONFIRMATION=true
MAX_FILE_SIZE_MB=50
EXECUTION_TIMEOUT_SECONDS=60
